{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/react/index.ts"
  ],
  "tsconfig": "tsconfig.typedoc.json",
  "emit": "none",
  "readme": "none",
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  }
}
